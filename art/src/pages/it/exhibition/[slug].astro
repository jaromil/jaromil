---
import { getCollection, render } from 'astro:content';
import ExhibitionPage from '../../../components/pages/ExhibitionPage.astro';

export async function getStaticPaths() {
  const exhibitions = await getCollection('exhibitions');
  return exhibitions.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ExhibitionPage entry={entry}>
  <Content />
</ExhibitionPage>
