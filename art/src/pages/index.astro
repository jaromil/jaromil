---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import { getStageStates } from '../lib/stage';
import { pageLocale, t } from '../lib/i18n';

// The stage sequence itself is edited in src/lib/stage.ts.
const locale = pageLocale(Astro.url.pathname);
const states = await getStageStates(locale);
---

<Base stageControls>
  <h1 class="visually-hidden">{t(locale, 'stageHome')}</h1>
  <Stage states={states} />
</Base>
