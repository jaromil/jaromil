---
import { pageLocale, t } from '../lib/i18n';

interface Props {
  /** Short context label, e.g. the practice a work belongs to. */
  context?: string;
  /** Show stage step arrows (homepage only). */
  stageControls?: boolean;
}
const { context, stageControls = false } = Astro.props;
const locale = pageLocale(Astro.url.pathname);
---

<nav class="bottom-bar" aria-label={t(locale, 'index')}>
  <div class="stepping">
  {
    stageControls && (
      <button class="step" type="button" data-prev aria-label={t(locale, 'prevWork')}>
        ←
      </button>
    )
  }
  <span class="counter" data-bb-counter aria-hidden="true"></span>
  {
    stageControls && (
      <button class="step" type="button" data-next aria-label={t(locale, 'nextWork')}>
        →
      </button>
    )
  }
  </div>
  <span class="context" data-bb-context>{context ?? ''}</span>
  <button class="open" type="button" data-open-index aria-haspopup="dialog" aria-expanded="false">
    <span aria-hidden="true">↑</span> {t(locale, 'index')}
  </button>
</nav>

<style>
  .bottom-bar {
    position: fixed;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: 40;
    display: none;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    padding: 0.9rem var(--space-edge);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--black);
  }
  .counter { color: var(--grey); }
  .stepping {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .stepping:has(.counter:empty) { display: none; }
  .counter:empty { display: none; }
  .step {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    min-inline-size: 44px;
    min-block-size: 44px;
    font: inherit;
    color: var(--grey);
    cursor: pointer;
  }
  .step:hover { color: var(--white); }
  .context {
    flex: 1 1 4rem;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .open {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    min-block-size: 44px;
    flex-shrink: 0;
    white-space: nowrap;
    margin-inline-start: auto;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--grey);
    cursor: pointer;
  }
  .open:hover { color: var(--white); }

  @media (max-width: 767px) {
    .bottom-bar { display: flex; }
  }
</style>
