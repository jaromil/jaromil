---
import Base from '../../layouts/Base.astro';
import { pageLocale, t } from '../../lib/i18n';

const locale = pageLocale(Astro.url.pathname);
---

<Base title={t(locale, 'bio')} context={t(locale, 'bio')}>
  <div class="page">
    <header>
      <h1 class="title">Jaromil</h1>
      <p class="meta">Denis Roio · b. 1977 · Lugano</p>
    </header>

    <div class="body essay">
      <p>{t(locale, 'bioP1')}</p>
      <p>{t(locale, 'bioP2')}</p>
      <p class="todo">{t(locale, 'bioTodo')}</p>
    </div>
  </div>
</Base>
