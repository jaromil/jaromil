---
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href, pageLocale, t } from '../../lib/i18n';

interface Props {
  entry: CollectionEntry<'exhibitions'>;
}

const { entry } = Astro.props;
const { title, curator, showings, works } = entry.data;
const locale = pageLocale(Astro.url.pathname);

const workEntries = (await Promise.all(works.map((reference) => getEntry(reference)))).filter(
  (w) => w !== undefined,
);
---

<Base title={title} context={t(locale, 'exhibition')}>
  <article class="page">
    <header>
      <p class="context">{t(locale, 'exhibition')}</p>
      <h1 class="title">{title}</h1>
      {curator && <p class="meta">{t(locale, 'curatedBy')} {curator}</p>}
    </header>

    <section aria-labelledby="showings-heading">
      <h2 class="section-label" id="showings-heading">{t(locale, 'showings')}</h2>
      <ul class="index-list">
        {
          showings.map((showing) => (
            <li>
              <span>{showing.venue}</span>
              <span class="aside">
                {showing.year} · {showing.city}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="body">
      <slot />
    </div>

    {
      workEntries.length > 0 && (
        <section aria-labelledby="works-heading">
          <h2 class="section-label" id="works-heading">
            {t(locale, 'worksShown')}
          </h2>
          <ul class="index-list">
            {workEntries.map((work) => (
              <li>
                <a href={href(`work/${work.id}`, locale)}>{work.data.title}</a>
                <span class="aside">{work.data.year ?? ''}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>

<style>
  section {
    margin-block-start: 3rem;
  }
  .body {
    margin-block-start: 3rem;
  }
</style>
