---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href, pageLocale, t } from '../../lib/i18n';

const locale = pageLocale(Astro.url.pathname);
const texts = await getCollection('texts');
texts.sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<Base title={t(locale, 'texts')} context={t(locale, 'texts')}>
  <div class="page">
    <header>
      <h1 class="title">{t(locale, 'texts')}</h1>
    </header>
    <ul class="index-list">
      {
        texts.map((text) => (
          <li>
            <a href={href(`text/${text.id}`, locale)}>{text.data.title}</a>
            <span class="aside">
              {[text.data.year, text.data.status === 'draft' ? t(locale, 'forthcoming') : null]
                .filter(Boolean)
                .join(' · ')}
            </span>
          </li>
        ))
      }
    </ul>
    <p class="caption">
      {t(locale, 'journalNote')}
      <a href="https://jaromil.dyne.org/journal/">jaromil.dyne.org/journal</a>.
    </p>
  </div>
</Base>

<style>
  .caption {
    margin-block-start: 3rem;
  }
</style>
