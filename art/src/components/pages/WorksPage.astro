---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href, pageLocale, t } from '../../lib/i18n';

const locale = pageLocale(Astro.url.pathname);
const works = await getCollection('works');
works.sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<Base title={t(locale, 'works')} context={t(locale, 'works')}>
  <div class="page">
    <header>
      <h1 class="title">{t(locale, 'works')}</h1>
    </header>
    <ul class="index-list">
      {
        works.map((work) => (
          <li>
            <a href={href(`work/${work.id}`, locale)}>{work.data.title}</a>
            <span class="aside">
              {[work.data.year, work.data.practice?.id].filter(Boolean).join(' · ')}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
