---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { href, pageLocale, t } from '../../lib/i18n';

const locale = pageLocale(Astro.url.pathname);
const exhibitions = await getCollection('exhibitions');
---

<Base title={t(locale, 'exhibitions')} context={t(locale, 'exhibitions')}>
  <div class="page">
    <header>
      <h1 class="title">{t(locale, 'exhibitions')}</h1>
    </header>
    {
      exhibitions.length === 0 ? (
        <p class="todo">{t(locale, 'noExhibitions')}</p>
      ) : (
        <ul class="index-list">
          {exhibitions.map((exhibition) => (
            <li>
              <a href={href(`exhibition/${exhibition.id}`, locale)}>{exhibition.data.title}</a>
              <span class="aside">
                {exhibition.data.showings.map((s) => s.year).join(', ')}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
