---
import { getImage } from 'astro:assets';
import type { Media } from '../lib/media';
import { fileAsset, imageAsset } from '../lib/assets';
import { pageLocale, t } from '../lib/i18n';

interface Props {
  media: Extract<Media, { type: 'video' }>;
  class?: string;
}

const { media, class: className } = Astro.props;
const locale = pageLocale(Astro.url.pathname);

// Autoplay is only ever allowed muted and inline (no unexpected audio).
const autoplay = media.autoplay && media.muted;

const poster = media.poster
  ? await getImage({ src: imageAsset(media.poster), format: 'webp', width: 1600 })
  : undefined;
---

<figure class:list={['media-video', className]} style={media.aspect ? `--aspect: ${media.aspect}` : undefined}>
  <video
    muted={media.muted || autoplay}
    loop={media.loop || undefined}
    controls={media.controls || undefined}
    playsinline
    preload="none"
    poster={poster?.src}
    data-autoplay={autoplay || undefined}
  >
    {media.sources.map((s) => <source src={fileAsset(s.src)} type={s.type} />)}
  </video>
  <p class="caption" data-video-fallback hidden><a href={fileAsset(media.sources[0].src)}>{t(locale, 'watchVideo')}</a></p>
  <noscript><p class="caption"><a href={fileAsset(media.sources[0].src)}>{t(locale, 'watchVideo')}</a></p></noscript>
  {media.caption && <figcaption class="caption">{media.caption}</figcaption>}
</figure>

<style>
  .media-video { margin: 0; }
  .media-video video {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: var(--aspect, auto);
    background: var(--black);
  }
  figcaption { margin-block-start: 0.6rem; }
</style>

<script>
  // Pause autoplaying videos when they leave the viewport; resume on return.
  if (document.documentElement.dataset.videoInit !== 'true') {
    document.documentElement.dataset.videoInit = 'true';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          // Intersection alone is not enough: an element inside an inert or
          // hidden ancestor (e.g. an inactive stage state) still intersects.
          const concealed = video.closest('[inert], [hidden]') !== null;
          if (entry.isIntersecting && !concealed && !reduced.matches && !saveData && !document.hidden) video.play().catch(() => {});
          else video.pause();
        }
      },
      { threshold: 0.25 },
    );

    const watch = () => {
      document.querySelectorAll<HTMLVideoElement>('.media-video video').forEach((video) => {
        if (reduced.matches || saveData) video.controls = true;
        video.addEventListener('error', () => {
          const fallback = video.closest('figure')?.querySelector<HTMLElement>('[data-video-fallback]');
          if (fallback) fallback.hidden = false;
        }, { capture: true, once: true });
        if (video.hasAttribute('data-autoplay')) observer.observe(video);
      });
    };

    document.addEventListener('play', (event) => {
      if (!(event.target instanceof HTMLVideoElement)) return;
      document.querySelectorAll<HTMLVideoElement>('video').forEach(video => {
        if (video !== event.target) video.pause();
      });
    }, true);
    const pauseAll = () => document.querySelectorAll<HTMLVideoElement>('video').forEach(video => video.pause());
    document.addEventListener('astro:before-swap', () => { observer.disconnect(); pauseAll(); });
    window.addEventListener('pagehide', pauseAll);
    document.addEventListener('visibilitychange', () => { if (document.hidden) pauseAll(); });

    document.addEventListener('astro:page-load', watch);
  }
</script>
