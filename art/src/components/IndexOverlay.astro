---
import { getCollection } from 'astro:content';
import { href, pageLocale, t } from '../lib/i18n';

const locale = pageLocale(Astro.url.pathname);
const practices = (await getCollection('practices')).filter((p) => !p.id.startsWith('_'));
const works = (await getCollection('works')).filter((w) => !w.id.startsWith('_'));
works.sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const practiceGroups = practices.map((practice) => ({
  practice,
  works: works.filter((work) => work.data.practice?.id === practice.id),
}));
const standaloneWorks = works.filter((work) => !work.data.practice);
---

<div class="overlay" id="index-overlay" role="dialog" aria-modal="true" aria-label="Index" hidden>
  <nav class="panel" aria-label="Site index">
    <section class="pages">
      <h2>{t(locale, 'siteNav')}</h2>
      <ul>
        <li><a href={href('practices', locale)}>{t(locale, 'practices')}</a></li>
        <li><a href={href('works', locale)}>{t(locale, 'works')}</a></li>
        <li><a href={href('texts', locale)}>{t(locale, 'texts')}</a></li>
        <li><a href={href('exhibitions', locale)}>{t(locale, 'exhibitions')}</a></li>
        <li><a href={href('bio', locale)}>{t(locale, 'bio')}</a></li>
      </ul>
    </section>
    <section class="corpus" aria-labelledby="corpus-heading">
      <h2 class="relationship-label" id="corpus-heading">
        <span>{t(locale, 'practices')}</span>
        <span class="separator" aria-hidden="true">/</span>
        <span>{t(locale, 'works')}</span>
      </h2>
      <div class="practice-groups">
        {
          practiceGroups.map(({ practice, works: primaryWorks }) => (
            <section class="practice-group" data-practice-group={practice.id} aria-labelledby={`index-${practice.id}`}>
              <h3 id={`index-${practice.id}`}>
                <a href={href(`practice/${practice.id}`, locale)}>{practice.data.title}</a>
              </h3>
              <ul class="work-list" aria-label={`${practice.data.title}: ${t(locale, 'works')}`}>
                {primaryWorks.map((work) => (
                  <li><a href={href(`work/${work.id}`, locale)}>{work.data.title}</a></li>
                ))}
              </ul>
            </section>
          ))
        }
        {
          standaloneWorks.length > 0 && (
            <section class="practice-group standalone">
              <h3>{t(locale, 'works')}</h3>
              <ul class="work-list">
                {standaloneWorks.map((work) => (
                  <li><a href={href(`work/${work.id}`, locale)}>{work.data.title}</a></li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </section>
  </nav>
  <button class="close" type="button" data-close-index aria-label={t(locale, 'closeIndex')}>×</button>
</div>

<style>
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--black);
    overflow-y: auto;
    padding: 4.5rem var(--space-edge) 5rem;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .overlay.open { opacity: 1; }
  .panel {
    display: grid;
    gap: 5rem;
    max-inline-size: 70rem;
  }
  h2 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey);
    margin-block-end: 1rem;
  }
  .relationship-label {
    display: flex;
    gap: 0.65rem;
  }
  .practice-groups {
    border-block-end: 1px solid color-mix(in srgb, var(--grey) 22%, transparent);
  }
  .practice-group {
    padding-block: 1.25rem 1.5rem;
    border-block-start: 1px solid color-mix(in srgb, var(--grey) 22%, transparent);
  }
  h3 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.2;
  }
  .work-list {
    margin-block-start: 0.9rem;
    padding-inline-start: 1rem;
    border-inline-start: 1px solid color-mix(in srgb, var(--grey) 42%, transparent);
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding-block: 0.35rem; }
  a {
    text-decoration: underline;
    text-decoration-color: transparent;
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .work-list a { font-size: var(--step-0); }
  a:hover { text-decoration-color: currentColor; }
  .pages {
    padding-block-end: 1.25rem;
    border-block-end: 1px solid color-mix(in srgb, var(--grey) 22%, transparent);
  }
  .pages ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: 2rem;
    row-gap: 0.25rem;
  }
  .pages a { font-size: var(--step-0); }
  @media (min-width: 768px) {
    .relationship-label,
    .practice-group {
      display: grid;
      grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1.6fr);
      column-gap: clamp(2rem, 6vw, 6rem);
    }
    .relationship-label .separator { display: none; }
    .practice-group { align-items: start; }
    .work-list {
      margin-block-start: 0;
      padding-inline-start: clamp(1.25rem, 2.5vw, 2rem);
    }
  }
  .close {
    position: fixed;
    inset-block-start: 1rem;
    inset-inline-end: var(--space-edge);
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: var(--step-1);
    color: var(--grey);
    cursor: pointer;
  }
  .close:hover { color: var(--white); }
</style>

<script>
  // Document-level listeners are registered once; the overlay element is
  // queried fresh on every event because ClientRouter swaps page DOM.
  if (!(document.documentElement.dataset.indexInit === 'true')) {
    document.documentElement.dataset.indexInit = 'true';
    let lastTrigger: HTMLElement | null = null;

    const overlay = () => document.getElementById('index-overlay');
    const setExpanded = (value: boolean) =>
      document
        .querySelectorAll<HTMLElement>('[data-open-index]')
        .forEach((t) => t.setAttribute('aria-expanded', String(value)));

    function open(trigger: HTMLElement) {
      const el = overlay();
      if (!el) return;
      lastTrigger = trigger;
      el.hidden = false;
      requestAnimationFrame(() => el.classList.add('open'));
      document.body.style.overflow = 'hidden';
      // Keep keyboard focus inside the dialog.
      document.querySelectorAll('main, .site-header, .bottom-bar, .skip-link').forEach((n) => {
        (n as HTMLElement).inert = true;
      });
      setExpanded(true);
      el.querySelector<HTMLElement>('a')?.focus();
    }

    function close() {
      const el = overlay();
      if (!el) return;
      el.classList.remove('open');
      document.body.style.overflow = '';
      document.querySelectorAll('main, .site-header, .bottom-bar, .skip-link').forEach((n) => {
        (n as HTMLElement).inert = false;
      });
      setExpanded(false);
      const done = () => {
        el.hidden = true;
        el.removeEventListener('transitionend', done);
      };
      el.addEventListener('transitionend', done);
      // Fallback if the transition does not run (reduced motion).
      setTimeout(done, 600);
      lastTrigger?.focus();
    }

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const opener = target.closest<HTMLElement>('[data-open-index]');
      if (opener) {
        overlay()?.hidden ? open(opener) : close();
        return;
      }
      if (target.closest('[data-close-index]')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && overlay() && !overlay()!.hidden) close();
    });
  }
</script>
