---
import { href, pageLocale } from '../lib/i18n';
import LangSwitch from './LangSwitch.astro';

const locale = pageLocale(Astro.url.pathname);
---

<header class="site-header">
  <a class="wordmark" href={href('', locale)} aria-label="Jaromil — home">JAROMIL</a>
  <div class="controls">
    <LangSwitch />
    <button class="info" type="button" data-open-index aria-haspopup="dialog" aria-expanded="false">
      INDEX
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 40;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem var(--space-edge);
    /* Opaque so scrolling body text never prints through the chrome */
    background: var(--black);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
  }
  .wordmark {
    text-decoration: underline;
    text-decoration-color: transparent;
  }
  .wordmark:hover { text-decoration-color: currentColor; }
  .controls {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }
  .info {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    letter-spacing: inherit;
    color: var(--grey);
    cursor: pointer;
  }
  .info:hover { color: var(--white); }
</style>
