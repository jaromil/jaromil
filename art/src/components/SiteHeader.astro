---
import { href, pageLocale, t } from '../lib/i18n';
import LangSwitch from './LangSwitch.astro';

const locale = pageLocale(Astro.url.pathname);
---

<header class="site-header">
  <a class="wordmark" href={href('', locale)} aria-label={t(locale, 'home')}>JAROMIL</a>
  <div class="controls">
    <LangSwitch />
    <button class="info" type="button" data-open-index aria-haspopup="dialog" aria-expanded="false">
      {t(locale, 'index')}
    </button>
    <noscript>
      <a class="no-js-browse" href={href('works', locale)}>{t(locale, 'works')}</a>
      <style is:inline>
        [data-open-index], [data-lang-switch], .bottom-bar [data-prev], .bottom-bar [data-next] { display: none !important; }
      </style>
    </noscript>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 40;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem var(--space-edge);
    /* Opaque so scrolling body text never prints through the chrome */
    background: var(--black);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
  }
  .wordmark {
    min-block-size: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: underline;
    text-decoration-color: transparent;
  }
  .wordmark:hover { text-decoration-color: currentColor; }
  .controls {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-inline-start: auto;
  }
  .info {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    min-block-size: 44px;
    min-inline-size: 44px;
    font: inherit;
    letter-spacing: inherit;
    text-transform: uppercase;
    color: var(--grey);
    cursor: pointer;
  }
  .info:hover { color: var(--white); }
</style>
